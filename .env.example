# Connection
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Prompt paths relative to prompt/
DEFAULT_PROMPT_NAME=prompts/few-shot.txt
DEFAULT_SYSTEM_PROMPT_NAME=system/knowledge_graph.txt

# JSONL logs; leave empty to disable
OLLAMA_JSONL_PATH=logs/ollama_responses.jsonl
ANALYZE_LOG_PATH=logs/analyze_log.jsonl

# Conservative LLM settings
OLLAMA_SEED=42
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_K=1
OLLAMA_TOP_P=1
OLLAMA_MIN_P=0
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_SECONDS=300
